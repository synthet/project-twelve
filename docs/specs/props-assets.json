{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "spec_id": "project-twelve/props-assets/v1",
  "title": "ProjectTwelve World Prop Sprite Specification",
  "description": "First-party AI-generated world decoration props: frame-to-sprite mapping and Unity import policy consumed by scripts/normalize_pixellab_props.py.",
  "output_dir": "Assets/Sprites/Props/Generated",
  "generator": {
    "service": "PixelLab",
    "tool": "create_1_direction_object",
    "view": "sidescroller",
    "batches": {
      "batchA": { "canvas_px": 32, "count": 64, "promoted": 63 },
      "batchB": { "canvas_px": 64, "count": 16, "promoted": 16 }
    },
    "style_reference": "Nearest-neighbour crops of the existing prop set, staged locally in tools/pixellab-ref/ (gitignored; never committed)."
  },
  "unity_import": {
    "format": "PNG",
    "color_mode": "RGBA",
    "sprite_mode": "Single",
    "mesh_type": "Full Rect",
    "pixels_per_unit": 32,
    "filter_mode": "Point",
    "compression": "None",
    "generate_mip_maps": false,
    "alpha_is_transparency": true,
    "pivot": [0.5, 0.5],
    "packing_tag": "props"
  },
  "scale_policy": {
    "world_tile_px": 16,
    "world_tile_units": 1,
    "prop_ppu": 32,
    "small_prop_footprint_tiles": 1,
    "large_prop_footprint_tiles": 2,
    "rationale": "PixelLab's minimum canvas is 32 px, so native 16 px prop art is unreachable. Downscaling 32 -> 16 visibly degraded the art, so props keep full detail and are imported at PPU 32. A small prop then covers one 16 px world tile and a large prop covers two, matching the footprints of the existing prop set.",
    "tradeoff": "Props carry 2x the pixel density of the 16 px terrain layer. docs/wiki/15-assets-integration.md permits mixed tile art only when the import preset and PPU policy make in-game size explicit, which is why the PPU is pinned here and in the generated README."
  },
  "conformance_rules": {
    "exact_size": "Every frame must match its declared size; failures are re-rolled, never resampled.",
    "binary_alpha": "Alpha must be 0 or 255 (no anti-aliasing).",
    "max_colors": 48,
    "keep_largest_component": false
  },
