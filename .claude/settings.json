{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-check.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(git add --all:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets.json)",
      "Read(~/.ssh/**)"
    ],
    "additionalDirectories": []
  },
  "enabledMcpjsonServers": [],
  "disabledMcpjsonServers": [
    "pixellab"
  ]
}
